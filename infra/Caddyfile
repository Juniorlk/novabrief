# Reverse proxy for staging and production.
#
# Caddy obtains and renews TLS certificates on its own, which is why it is here
# rather than nginx: one less scheduled job to forget on a server with no
# operations team (section 15.2).

{
	email {$ACME_EMAIL}
}

# API
{$API_DOMAIN} {
	encode zstd gzip

	# HSTS, and the headers that stop the browser being helpful in ways we do
	# not want. The API serves JSON only, so a permissive CSP costs nothing and
	# a strict one costs nothing either.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# The interactive documentation is the one HTML page this host serves, and
	# `default-src 'none'` correctly refuses to run it. Its assets are vendored
	# into the image rather than fetched from a CDN, so this stays at 'self':
	# the page lives on the same origin as the authentication API and is where
	# a person pastes an access token.
	#
	# 'unsafe-inline' is needed for the small bootstrap script FastAPI emits.
	# Scoped to these two paths, so the API itself keeps refusing everything.
	@docs path /api/v1/docs /api/v1/docs/* /api/v1/static/*
	header @docs {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
	}

	# The health probes stay out of the access log: they run every few seconds
	# and would bury everything else.
	@health path /health /health/ready
	log_skip @health

	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}

# Web application
{$WEB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Until the web application exists (lot L4) there is nothing behind this.
	# A sentence beats a bare 502: somebody typing the address should learn
	# that it is not deployed yet, not that something is broken.
	handle_errors {
		respond "NovaBrief : l'application web n'est pas encore deployee." 503
	}

	reverse_proxy web:3000

	log {
		output stdout
		format json
	}
}
