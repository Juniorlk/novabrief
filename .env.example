# =============================================================================
# NovaBrief — configuration template. Section numbers refer to the specification
# (NVK-CDC-NB-2026-V1.0), sections 15 to 22. Copy to `.env` and fill in.
# `.env` is ignored by Git. Every value is empty here: no secret, no implicit
# default. A committed secret is an incident: revoke it immediately.
# =============================================================================

# -----------------------------------------------------------------------------
# Application (15.1, 22.2) — three environments: dev, staging, prod.
# -----------------------------------------------------------------------------
ENVIRONMENT=                       # dev | staging | prod
API_BASE_URL=                      # e.g. https://api.novabrief.com
WEB_BASE_URL=                      # e.g. https://app.novabrief.com
CORS_ALLOWED_ORIGINS=              # comma-separated list (21.1)
SECRET_KEY=                        # internal application signing key
DEFAULT_MARKET=                    # CM — the market selects plan and currency (ADR-09)
DEFAULT_LOCALE=                    # fr | en
DEFAULT_TIMEZONE=                  # Africa/Douala — renewal reminders at 08:00 (20.3)

# -----------------------------------------------------------------------------
# Logging and observability (15.2, 22.3) — never any meeting content.
# -----------------------------------------------------------------------------
LOG_LEVEL=                         # debug | info | warning | error
LOG_FORMAT=                        # json (structlog) | console (dev only)
LOG_RETENTION_DAYS=                # 30
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_DESKTOP=
SENTRY_TRACES_SAMPLE_RATE=
METRICS_ENABLED=                   # true | false (Prometheus endpoint)
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=
UPTIME_KUMA_PUSH_URL=

# -----------------------------------------------------------------------------
# PostgreSQL 16 (15.2, 19.2) — RLS enabled, never a BYPASSRLS role (ADR-04).
# -----------------------------------------------------------------------------
DATABASE_URL=                      # postgresql+asyncpg://novabrief_app:pass@host:5432/novabrief
                                   # Restricted role, no SUPERUSER and no BYPASSRLS: a
                                   # superuser bypasses RLS and voids ADR-04.
DATABASE_ADMIN_URL=                # migration (DDL) credentials, separate from the API
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
DATABASE_STATEMENT_TIMEOUT_MS=
POSTGRES_USER=                     # local docker-compose (infra/)
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_APP_PASSWORD=             # password of the restricted role, used by infra/postgres-init

# -----------------------------------------------------------------------------
# Redis, Celery (15.1, 22.3) — processing queue and scheduled jobs.
# -----------------------------------------------------------------------------
REDIS_URL=                         # redis://host:6379/0
CELERY_BROKER_URL=                 # falls back to REDIS_URL
CELERY_RESULT_BACKEND=             # falls back to REDIS_URL
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=  # 1800; the hard limit is this plus 60 s
PURGE_CRON_HOUR=                   # 2  — 02:00 UTC (22.3)
PURGE_CRON_MINUTE=                 # 0
RENEWAL_REMINDERS_CRON=            # 0 8 * * *  (08:00 Africa/Douala, 20.3)
PAYMENT_RECONCILIATION_CRON=

# -----------------------------------------------------------------------------
# Cloudflare R2 (15.2, 21.1) — private bucket, 15-minute presigned URLs.
# -----------------------------------------------------------------------------
# Use an R2 *Account* API token, not a User one: a user token dies when that
# person's Cloudflare access changes, taking production writes with it.
# Permission: Object Read & Write, scoped to the audio bucket. Not Admin -
# the API has no reason to be able to delete a bucket.
R2_ACCOUNT_ID=                     # 32 hex characters; not a secret
R2_ENDPOINT=                       # https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=              # shown once by Cloudflare
R2_REGION=                         # auto - R2 has no regions and rejects anything else
R2_BUCKET_AUDIO=                   # novabrief-audio; keep the bucket private
R2_BUCKET_INVOICES=
R2_BUCKET_BACKUPS=                 # separate account (22.3)
R2_PRESIGN_TTL_SECONDS=            # 900
R2_MULTIPART_PART_SIZE_BYTES=      # about 5 MB (16.4); S3 refuses smaller parts

# Local development only: MinIO stands in for R2 and keeps its own root
# credentials, so a real R2 key in this file is never handed to a container.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Authentication and authorisation (17.3, 21.1).
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY=                   # RS256, escaped PEM or mounted path
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_MINUTES=            # 15
REFRESH_TOKEN_TTL_DAYS=            # 30, rotation + reuse detection
ARGON2_TIME_COST=
ARGON2_MEMORY_COST_KIB=
ARGON2_PARALLELISM=
TOTP_ISSUER=                       # NovaBrief — 2FA, mandatory for the back-office
DEVICE_LINK_CODE_TTL_MINUTES=      # 6-character device pairing code (17.1)
WS_TICKET_TTL_SECONDS=             # single-use WebSocket ticket

# -----------------------------------------------------------------------------
# Rate limiting and idempotency (17.3).
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=        # 10
RATE_LIMIT_API_PER_MINUTE=         # 600
IDEMPOTENCY_KEY_TTL_HOURS=         # 24

# -----------------------------------------------------------------------------
# Transcription (15.2, 18.1) — reachable only through TranscriptionProvider
# (ADR-01). The preference order is changeable without redeployment.
# -----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER_ORDER=      # assemblyai,deepgram
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=                  # universal-3.5
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=                    # nova-3
WHISPER_ENDPOINT_URL=              # phase 3, self-hosted (5.8)
WHISPER_MODEL=                     # large-v3
TRANSCRIPTION_TIMEOUT_SECONDS=
CIRCUIT_BREAKER_FAILURE_THRESHOLD= # 5 failures
CIRCUIT_BREAKER_WINDOW_SECONDS=    # 600
CIRCUIT_BREAKER_HALF_OPEN_SECONDS= # 120

# -----------------------------------------------------------------------------
# LLM (18.1, 18.5) — reachable only through LLMProvider (ADR-01), output is JSON
# validated by a Pydantic schema (ADR-03), audio is never sent (ADR-02).
# -----------------------------------------------------------------------------
LLM_PROVIDER=                      # openai
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=              # gpt-5-mini
OPENAI_MODEL_LIGHT=                # gpt-5-nano — title, participants, translation
LLM_TEMPERATURE=                   # 0.1
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_COST_USD_PER_MEETING=      # 0.50 — above this: alert and stop retrying
PROMPT_VERSION=                    # extract_v1 (packages/ai/prompts/)

# -----------------------------------------------------------------------------
# Billing (20) — no price lives in the code, everything comes from the `plans`
# and `prices` tables (ADR-09).
# -----------------------------------------------------------------------------
BILLING_PROVIDER_DEFAULT=          # flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=          # verif-hash header (20.2)
FLUTTERWAVE_BASE_URL=              # sandbox or production
STRIPE_SECRET_KEY=                 # V1.1, markets outside CEMAC
STRIPE_WEBHOOK_SECRET=
PAYMENT_POLLING_INTERVAL_SECONDS=  # 3 (20.2)
INVOICE_SERIES_PREFIX=             # NB — yearly series NB-2027-000001
VAT_APPLICABLE=                    # false until Novafrik moves to the real tax regime
VAT_RATE_PERCENT=                  # 19.25 (5.4)

# -----------------------------------------------------------------------------
# Transactional email (15.2).
# -----------------------------------------------------------------------------
RESEND_API_KEY=                    # without a key the API prints emails to the console (dev)
EMAIL_FROM=                        # e.g. NovaBrief <no-reply@novabrief.com>
EMAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# Data retention (ADR-06, 16.3, 22.3).
# -----------------------------------------------------------------------------
AUDIO_RETENTION_DAYS_DEFAULT=      # 30
AUDIO_RETENTION_DAYS_BUSINESS=     # 90
LOCAL_RECORDING_KEEP_HOURS=        # 24 after the upload is confirmed (16.3)
LOCAL_RECORDING_KEEP_HOURS_FAILED= # 72 when processing failed
FREE_DOWNGRADE_DATA_KEEP_DAYS=     # 90 (20.3)

# -----------------------------------------------------------------------------
# Backups (22.3) — RPO 6 h, RTO 2 h.
# -----------------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=             # 6
BACKUP_RETENTION_DAYS=             # 30
BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Desktop application (16.5) — code signing and updates.
# -----------------------------------------------------------------------------
TAURI_SIGNING_PRIVATE_KEY=         # Ed25519, signs the update manifest
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TAURI_UPDATER_ENDPOINT=            # manifest published on R2
UPDATE_CHANNEL=                    # stable | beta
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_ACCOUNT=
AZURE_TRUSTED_SIGNING_PROFILE=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
DESKTOP_TELEMETRY_ENABLED=         # opt-out, never any content (16.5)

# -----------------------------------------------------------------------------
# Operational alerting (22.3).
# -----------------------------------------------------------------------------
ALERT_PROCESSING_FAILURE_RATE_PERCENT=   # 2 over 1 h
ALERT_QUEUE_DELAY_MINUTES=               # 30
ALERT_COST_PER_HOUR_XAF=                 # 200
ALERT_DISK_USAGE_PERCENT=                # 80
ALERT_WEBHOOK_URL=
