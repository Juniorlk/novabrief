# =============================================================================
# NovaBrief — modèle de configuration (cahier des charges NVK-CDC-NB-2026-V1.0,
# sections 15 à 22). Copier en `.env` et renseigner. `.env` est ignoré par Git.
# Toutes les valeurs sont vides : aucun secret, aucun défaut implicite.
# Un secret commité est un incident : le révoquer immédiatement (CLAUDE.md §6).
# =============================================================================

# -----------------------------------------------------------------------------
# Application (§15.1, §22.2) — trois environnements : dev, staging, prod.
# -----------------------------------------------------------------------------
ENVIRONMENT=                       # dev | staging | prod
API_BASE_URL=                      # ex. https://api.novabrief.com
WEB_BASE_URL=                      # ex. https://app.novabrief.com
CORS_ALLOWED_ORIGINS=              # liste séparée par des virgules (§21.1)
SECRET_KEY=                        # clé de signature applicative interne
DEFAULT_MARKET=                    # CM (ADR-09 : le marché choisit plan et devise)
DEFAULT_LOCALE=                    # fr | en
DEFAULT_TIMEZONE=                  # Africa/Douala (§20.3, relances 08:00)

# -----------------------------------------------------------------------------
# Journalisation et observabilité (§15.2, §22.3) — jamais de contenu de réunion.
# -----------------------------------------------------------------------------
LOG_LEVEL=                         # debug | info | warning | error
LOG_FORMAT=                        # json (structlog) | console (dev seulement)
LOG_RETENTION_DAYS=                # 30
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_DESKTOP=
SENTRY_TRACES_SAMPLE_RATE=
METRICS_ENABLED=                   # true | false (exposition Prometheus)
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=
UPTIME_KUMA_PUSH_URL=

# -----------------------------------------------------------------------------
# PostgreSQL 16 (§15.2, §19.2) — RLS active, jamais de rôle BYPASSRLS (ADR-04).
# -----------------------------------------------------------------------------
DATABASE_URL=                      # postgresql+asyncpg://user:pass@host:5432/novabrief
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
DATABASE_STATEMENT_TIMEOUT_MS=
POSTGRES_USER=                     # docker-compose local (infra/)
POSTGRES_PASSWORD=
POSTGRES_DB=

# -----------------------------------------------------------------------------
# Redis, Celery (§15.1, §22.3) — file de traitement et tâches planifiées.
# -----------------------------------------------------------------------------
REDIS_URL=                         # redis://host:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=
PURGE_AUDIO_CRON=                  # 0 2 * * *  (02:00 UTC, §22.3)
RENEWAL_REMINDERS_CRON=            # 0 8 * * *  (08:00 Africa/Douala, §20.3)
PAYMENT_RECONCILIATION_CRON=

# -----------------------------------------------------------------------------
# Cloudflare R2 (§15.2, §21.1) — bucket privé, URL présignées 15 min.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ENDPOINT=                       # https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=
R2_BUCKET_INVOICES=
R2_BUCKET_BACKUPS=                 # compte distinct (§22.3)
R2_PRESIGN_TTL_SECONDS=            # 900
R2_MULTIPART_PART_SIZE_BYTES=      # ≈ 5 Mo (§16.4)

# -----------------------------------------------------------------------------
# Authentification et autorisation (§17.3, §21.1).
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY=                   # RS256, PEM échappé ou chemin monté
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_MINUTES=            # 15
REFRESH_TOKEN_TTL_DAYS=            # 30, rotation + détection de réutilisation
ARGON2_TIME_COST=
ARGON2_MEMORY_COST_KIB=
ARGON2_PARALLELISM=
TOTP_ISSUER=                       # NovaBrief (2FA, obligatoire back-office)
DEVICE_LINK_CODE_TTL_MINUTES=      # code à 6 caractères (§17.1)
WS_TICKET_TTL_SECONDS=             # ticket WebSocket à usage unique

# -----------------------------------------------------------------------------
# Limitation de débit et idempotence (§17.3).
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=        # 10
RATE_LIMIT_API_PER_MINUTE=         # 600
IDEMPOTENCY_KEY_TTL_HOURS=         # 24

# -----------------------------------------------------------------------------
# Transcription (§15.2, §18.1) — accès uniquement via TranscriptionProvider
# (ADR-01). L’ordre de préférence est modifiable sans redéploiement.
# -----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER_ORDER=      # assemblyai,deepgram
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=                  # universal-3.5
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=                    # nova-3
WHISPER_ENDPOINT_URL=              # phase 3, auto-hébergé (§5.8)
WHISPER_MODEL=                     # large-v3
TRANSCRIPTION_TIMEOUT_SECONDS=
CIRCUIT_BREAKER_FAILURE_THRESHOLD= # 5 échecs
CIRCUIT_BREAKER_WINDOW_SECONDS=    # 600
CIRCUIT_BREAKER_HALF_OPEN_SECONDS= # 120

# -----------------------------------------------------------------------------
# LLM (§18.1, §18.5) — accès uniquement via LLMProvider (ADR-01), sortie JSON
# validée par schéma Pydantic (ADR-03), jamais d’audio envoyé (ADR-02).
# -----------------------------------------------------------------------------
LLM_PROVIDER=                      # openai
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=              # gpt-5-mini
OPENAI_MODEL_LIGHT=                # gpt-5-nano (titre, participants, traduction)
LLM_TEMPERATURE=                   # 0.1
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_COST_USD_PER_MEETING=      # 0.50 — au-delà : alerte et arrêt des relances
PROMPT_VERSION=                    # extract_v1 (packages/ai/prompts/)

# -----------------------------------------------------------------------------
# Facturation (§20) — aucun prix dans le code, tout vient des tables
# `plans` / `prices` (ADR-09).
# -----------------------------------------------------------------------------
BILLING_PROVIDER_DEFAULT=          # flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=          # en-tête verif-hash (§20.2)
FLUTTERWAVE_BASE_URL=              # sandbox ou production
STRIPE_SECRET_KEY=                 # V1.1, marchés hors CEMAC
STRIPE_WEBHOOK_SECRET=
PAYMENT_POLLING_INTERVAL_SECONDS=  # 3 (§20.2)
INVOICE_SERIES_PREFIX=             # NB (série annuelle NB-2027-000001)
VAT_APPLICABLE=                    # false tant que Novafrik n’est pas au réel
VAT_RATE_PERCENT=                  # 19.25 (§5.4)

# -----------------------------------------------------------------------------
# Email transactionnel (§15.2).
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# Conservation des données (ADR-06, §16.3, §22.3).
# -----------------------------------------------------------------------------
AUDIO_RETENTION_DAYS_DEFAULT=      # 30
AUDIO_RETENTION_DAYS_BUSINESS=     # 90
LOCAL_RECORDING_KEEP_HOURS=        # 24 après upload confirmé (§16.3)
LOCAL_RECORDING_KEEP_HOURS_FAILED= # 72 si le traitement a échoué
FREE_DOWNGRADE_DATA_KEEP_DAYS=     # 90 (§20.3)

# -----------------------------------------------------------------------------
# Sauvegardes (§22.3) — RPO 6 h, RTO 2 h.
# -----------------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=             # 6
BACKUP_RETENTION_DAYS=             # 30
BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Application desktop (§16.5) — signature et mise à jour.
# -----------------------------------------------------------------------------
TAURI_SIGNING_PRIVATE_KEY=         # Ed25519, manifeste d’update
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TAURI_UPDATER_ENDPOINT=            # manifeste publié sur R2
UPDATE_CHANNEL=                    # stable | beta
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_ACCOUNT=
AZURE_TRUSTED_SIGNING_PROFILE=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
DESKTOP_TELEMETRY_ENABLED=         # opt-out, jamais de contenu (§16.5)

# -----------------------------------------------------------------------------
# Alertes d’exploitation (§22.3).
# -----------------------------------------------------------------------------
ALERT_PROCESSING_FAILURE_RATE_PERCENT=   # 2 sur 1 h
ALERT_QUEUE_DELAY_MINUTES=               # 30
ALERT_COST_PER_HOUR_XAF=                 # 200
ALERT_DISK_USAGE_PERCENT=                # 80
ALERT_WEBHOOK_URL=
